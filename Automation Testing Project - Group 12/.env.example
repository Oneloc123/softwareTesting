# Horilla demo website
BASE_URL=https://hr.demo.horilla.com
HORILLA_BASE_URL=https://hr.demo.horilla.com

# Shared demo admin account. Replace these values if the demo credentials change.
USERNAME=admin
PASSWORD=admin
ADMIN_USER=admin
ADMIN_PASS=admin
HORILLA_USERNAME=admin
HORILLA_PASSWORD=admin
HORILLA_USER=admin
HORILLA_PASS=admin

# Browser settings
PLAYWRIGHT_CHANNEL=chromium
HEADLESS=true
WORKERS=1
RETRIES=0
TEST_TIMEZONE=Asia/Ho_Chi_Minh

# Nam test fixtures create temporary records and clean them after each case.
ALLOW_MUTATIONS=true

# Optional credentials for restricted/employee scenarios; leave blank if unavailable.
EMP_USER=
EMP_PASS=
HORILLA_RESTRICTED_USERNAME=
HORILLA_RESTRICTED_PASSWORD=

# Optional routes or test-specific data overrides
LOGIN_URL=/login/
BONUS_URL=/pms/employee-bonus-point/
EMPLOYEE_URL=/employee/employee-view/
PROJECTS_URL=/project/project-view/
TICKETS_URL=/helpdesk/helpdesk-settings-view/

# Optional stable identifier for each test execution
RUN_ID=

# -----------------------------------------------------------------------------
# Anh - Attendance / Onboarding / Offboarding fixtures
# Keep mutation and sensitive-action flags false unless using a dedicated test tenant.
# ANH_STORAGE_STATE is relative to the anh/ folder. Create it with npm run auth:save:anh.
# -----------------------------------------------------------------------------
ANH_STORAGE_STATE=playwright/.auth/user.json
RUN_ATTENDANCE_MUTATIONS=false
ATTENDANCE_ALLOW_CLOCK_ACTIONS=false
ATTENDANCE_SESSION_ROLE=

