BASE_URL=https://hr.demo.horilla.com
# Public demo credentials displayed by the demo login page.
USERNAME=admin
PASSWORD=admin
PLAYWRIGHT_CHANNEL=chrome
HEADLESS=true
WORKERS=1
RETRIES=0
# Leave blank to generate an identifier per run.
RUN_ID=
# Explicit timezone for input data; this is not a claim about server settings.
TEST_TIMEZONE=Asia/Ho_Chi_Minh
# Set to false to run only non-mutating cases. Skips are reported with reasons.
ALLOW_MUTATIONS=true
